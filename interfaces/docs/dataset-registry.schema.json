{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geo-map.local/schema/geo-map.dataset-registry/v0",
  "title": "geo-map dataset registry v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "datasets"],
  "properties": {
    "schema": {"const": "geo-map.dataset-registry/v0"},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dataset"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "backend", "bounds", "crs", "pyramid", "styles", "revision", "access"],
      "properties": {
        "id": {"type": "string", "description": "Slash-separated dataset id. Each segment starts with a letter or digit."},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "backend": {"enum": ["png", "cog"]},
        "bounds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"},
          "description": "West, south, east, north in WGS84 degrees. No antimeridian crossing."
        },
        "crs": {"enum": ["EPSG:3857", "EPSG:4326"]},
        "pyramid": {"anyOf": [{"$ref": "#/$defs/pyramid"}, {"type": "null"}]},
        "styles": {"type": "array", "items": {"$ref": "#/$defs/style"}},
        "revision": {"type": "string"},
        "access": {"$ref": "#/$defs/access"},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "quantitative": {"anyOf": [{"$ref": "#/$defs/quantitative"}, {"type": "null"}]},
        "legacy": {"$ref": "#/$defs/legacy"}
      }
    },
    "pyramid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "zooms", "block", "nodata"],
      "properties": {
        "layout": {"enum": ["legacy-v2", "legacy-v1"]},
        "zooms": {"$ref": "#/$defs/zooms"},
        "block": {"$ref": "#/$defs/block"},
        "nodata": {"$ref": "#/$defs/nodata"}
      }
    },
    "zooms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "stored", "view_min", "view_max"],
      "properties": {
        "native": {"type": "integer", "minimum": 0},
        "stored": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "view_min": {"type": "integer", "minimum": 0},
        "view_max": {"type": "integer", "minimum": 0}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge", "tile_pixels", "pixels"],
      "properties": {
        "merge": {"type": "integer", "minimum": 1, "maximum": 64},
        "tile_pixels": {"const": 256},
        "pixels": {"type": "integer", "description": "merge multiplied by tile_pixels. Stored PNG edge length."}
      }
    },
    "nodata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rgba"],
      "properties": {
        "rgba": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "kind": {"const": "styled-png"}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility"],
      "properties": {
        "visibility": {"enum": ["public", "restricted"]},
        "read_roles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "title", "media_type"],
      "properties": {
        "id": {"type": "string"},
        "role": {"enum": ["source-data", "metadata", "style"]},
        "title": {"type": "string"},
        "media_type": {"type": "string"},
        "local": {"type": "string", "description": "Path relative to the dataset directory. Never a URL."},
        "href": {"type": "string", "description": "https link returned as metadata. The server does not fetch it."}
      }
    },
    "quantitative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "path"],
      "properties": {
        "backend": {"enum": ["grid", "cog"]},
        "path": {"type": "string"},
        "band": {"type": "integer", "minimum": 1},
        "nodata": {"type": ["number", "null"]}
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_configured", "bounds_source"],
      "properties": {
        "version": {"type": ["number", "null"]},
        "imported_from": {"type": ["string", "null"]},
        "source_configured": {"type": "boolean"},
        "source_scheme": {"type": ["string", "null"]},
        "bounds_source": {"type": "string"}
      }
    }
  }
}
